	<!-- 获取账户复核记录数 -->
	<select id="getTradeCount" resultType="com.cmwa.ecc.business.entity.accountManger.TradeDto">
		SELECT NVL((SUM(DECODE(A.CHKFLAG || A.APPLYST, 'NN', 1, 0))), 0) AS ncount,
		       NVL((SUM(DECODE(A.CHKFLAG || A.APPLYST, 'YN', 1, 0))), 0) AS ycount,
		       NVL((SUM(DECODE(A.CHKFLAG, 'C', 1, 0))), 0) AS ccount,
		       NVL((SUM(DECODE(A.APPLYST || A.CHKFLAG, 'NR', 1, 0))), 0) AS fcount,
		       NVL((SUM(DECODE(A.APPLYST, 'C', 1, 0))), 0) AS cancelcount,
		       NVL((COUNT(*)), 0) AS totalcount
		  FROM APPFDACBLOTTER A
		 WHERE A.REGIONCODE = '0001'
		   AND A.WORKDATE = (SELECT RTRIM(KYDATE)
		                       FROM SYSALTER
		                      WHERE KEY1 = 'EC'
		                        AND KEY2 = 'SYS'
		                        AND KEY3 = 'WORKDATE')
	</select>
