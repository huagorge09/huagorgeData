	<!-- 查询线下一对一 客户资料信息 -->
	<select id="queryCbpOffLineOTOInvInfo" parameterType="sparam" resultMap="cbpOffLineOTOInvestMap">
		SELECT MAN.ID AS OFFINVSERIALNO,
		       MAN.MANDATOR_NAME AS OFFINVNAME,
		       MAN.MANDATOR_TYPE AS OFFINVTYPE,
		       MAN.MANDATOR_CODE_TYPE AS OFFINVIDTP,
		       MAN.MANDATOR_CODE AS OFFINVIDNO,
		       MAN.COUNTER_CODE AS OFFCOUNTERIDNO
		  FROM SYNC_CBP_VW_MANDATOR_INFO MAN
		 WHERE NOT EXISTS (SELECT 1
		          FROM ECC_MANDATORBLOTTER ECM
		         WHERE ECM.ID = MAN.ID
		           AND ECM.APPLYST IN ('N', 'Y'))
		<if test="sp.offInvName != null and sp.offInvName !='' ">
		   AND MAN.MANDATOR_NAME LIKE '%' || #{sp.offInvName} || '%'
		</if>
		<if test="sp.offInvType == 1">
		   AND TRIM(MAN.MANDATOR_TYPE) = '0'
		</if>
		<if test="sp.offInvType == 2 or sp.offInvType == 3">
		   AND TRIM(MAN.MANDATOR_TYPE) IN ('1','2')
		</if>
		<if test="sp.offInvType != 1 and sp.offInvType != 2 and sp.offInvType != 3">
		   AND 1 = 2
		</if>
	</select>
		
