	<select id="getFundAccount" parameterType="java.lang.String" resultType="com.cmwa.ecc.business.entity.accountManger.FundAcctDto">
		SELECT F.FUNDACCT	fundacco,
	           F.TANO		tano
	      FROM FUNDACCOINFO F
	     WHERE F.CUSTNO = #{custno}
	       AND F.FDACST = 'N'
	</select>
	
