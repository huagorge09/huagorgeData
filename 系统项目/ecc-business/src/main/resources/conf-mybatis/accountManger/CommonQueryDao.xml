	<!-- 查询最大的文件编号 -->
	<select id="getMaxFileNo" resultType="java.lang.String">
		SELECT 'NO.' ||
		       NVL((SELECT REPLACE(LPAD((MAX(SUBSTR(T.FILENO, 4, 5)) + 1), 5),
		                          ' ',
		                          '0')
		             FROM DS_CUSTINFODATA T),
		           (SELECT SUBSTR(T.PMCO, 4, 5)
		              FROM PARAMETER T
		             WHERE T.PMST = 'SYSTEM'
		               AND T.PMKY = 'FILENO'
		               AND T.PMCO != '******'))
		  FROM DUAL
	</select>
	
	<!-- 查询开户文件编号 -->
	<select id="getOpenFileNo" parameterType="java.lang.String" resultType="java.lang.String">
		SELECT D.FILENO
		  FROM APPFDACBLOTTER A, DS_CUSTINFODATA D
		 WHERE A.SERIALNO = D.APPSERIALNO
		   AND A.APKIND = '001'
		   AND A.CUSTNO = #{custno}
		 GROUP BY D.FILENO
	</select>
	
	<!-- 查询开户文件编号 -->
	<select id="getCustFileInfo" parameterType="java.lang.String" resultType="java.lang.String">
		SELECT SUBSTRB(T.FILENO, 1, 8) || '改' ||
		       (CASE
		          WHEN SUBSTRB(T.FILENO, 10, 12) IS NULL THEN
		           '1'
		          ELSE
		           TO_CHAR(SUBSTRB(T.FILENO, 10, 12) + 1)
		        END) AS FILENO
		  FROM DS_CUSTINFODATA T
		 WHERE SUBSTRB(T.KEEPADDRESS, 2, 5) =
		       (SELECT MAX(SUBSTRB(KEEPADDRESS, 2, 5))
		          FROM DS_CUSTINFODATA
		         WHERE CUSTNO = #{custno})
		   AND T.FILENO =
		       (SELECT MAX(FILENO) FROM DS_CUSTINFODATA WHERE CUSTNO = #{custno})
		   AND ROWNUM = 1
		   AND T.CUSTNO = #{custno}
	</select>
	
	<!-- 查询最大的文件编号 -->
	<select id="getMaxKeepAddress" resultType="java.lang.String">
		SELECT MAX(KEEPADDRESS) || ',' || COUNT(*) AS COUNTROW
		  FROM (SELECT KEEPADDRESS, CUSTNO
		          FROM DS_CUSTINFODATA
		         WHERE KEEPADDRESS =
		               (SELECT KEEPADDRESS
		                  FROM DS_CUSTINFODATA
		                 WHERE SUBSTRB(FILENO, 1, 8) =
		                       (SELECT MAX(SUBSTRB(FILENO, 1, 8)) FROM DS_CUSTINFODATA)
		                   AND ROWNUM = 1)
		         GROUP BY CUSTNO, KEEPADDRESS)
	</select>
	
	<!-- 查询最大的文件编号 -->
