			   INVTP	individualorinstitution
		  FROM (SELECT APPNO, FUNDACCT, APDT, C.INVNM, C.INVTP
			          FROM H_APPFDACBLOTTER T, CUSTINFO C
			         WHERE ROWNUM = 1
			           AND T.CUSTNO = C.CUSTNO
			           AND APPLYST = 'S'
			           AND APKIND = '001'
			           AND T.CUSTNO = #{custno}
			        UNION
			        SELECT APPNO, FUNDACCT, APDT, C.INVNM, C.INVTP
			          FROM APPFDACBLOTTER T, CUSTINFO C
			         WHERE ROWNUM = 1
			           AND T.CUSTNO = C.CUSTNO
			           AND T.APPLYST = 'N'
			           AND T.TRANSST = 'N'
			           AND T.CUSTNO = #{custno}
			   )
		 WHERE ROWNUM = 1
	</select>
	
