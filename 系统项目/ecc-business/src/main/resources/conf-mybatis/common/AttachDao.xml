	<select id="queryEstimateFromCrmBp" resultMap="BaseResultMap">
		 SELECT DISTINCT * from   TFUNDDAY  where  to_char(D_DATE, 'yyyymmdd') = #{workDate}
		 and c_fundcode in
		<foreach collection="list" item="item" index="index" open="(" separator="," close=")"> 
			  			 #{item.funcode}
	    </foreach> 
