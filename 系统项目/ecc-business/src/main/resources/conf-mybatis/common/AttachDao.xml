<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cmwa.ecc.business.entity.fundinfo.AttachDao">

	<insert id="saveEleContract" parameterType="attachVo">
		<selectKey resultType="String" keyProperty="attId" order="BEFORE">
			SELECT SEQ_TCONTRACT.NEXTVAL AS ATTACHID FROM DUAL
		</selectKey>
		INSERT INTO CMF_EC_ELECONTRACT_ATTACH
		(ATTACHID, CONTENT, FILENAME)
		VALUES
		(#{attId,jdbcType=VARCHAR},#{attBlob,jdbcType=BLOB},#{attName,jdbcType=VARCHAR})
	</insert>
	
	<select id="getEleContract" resultType="int">
		SELECT SEQ_TCONTRACT.NEXTVAL AS ATTACHID FROM DUAL
	</select>
	
	<delete id="delEleContractAttach" parameterType="String">
		DELETE FROM CMF_EC_ELECONTRACT_ATTACH where ATTACHID=#{attId}
	</delete>
	
	<select id="queryEleContractAttach" parameterType="String" resultType="attachVo">
		SELECT ATTACHID AS attId,FILENAME AS attName,CONTENT AS attBlob FROM CMF_EC_ELECONTRACT_ATTACH WHERE ATTACHID =#{attId}
	</select>
	<select id="queryEleContractAttachList"  resultType="attachVo">
		SELECT ATTACHID AS attId,FILENAME AS attName FROM CMF_EC_ELECONTRACT_ATTACH WHERE ATTACHID IN 
	     <foreach item="item" index="index" collection="array" open="(" separator="," close=")"> 
			  			 #{item}
	    </foreach> 
	</select>
	
