<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xmlns:jsp="http://java.sun.com/xml/ns/javaee/jsp" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_3_0.xsd" version="3.0">
  <display-name>user</display-name>
  <context-param>
    <param-name>contextConfigLocation</param-name>
    <param-value>classpath*:conf-spring/*/spring-context-*.xml,
					 classpath*:conf-spring/spring-context-*.xml</param-value>
  </context-param>
  <listener>
    <listener-class>org.springframework.web.context.ContextLoaderListener</listener-class>
  </listener>
  <servlet>
    <servlet-name>springServlet</servlet-name>
    <servlet-class>org.springframework.web.servlet.DispatcherServlet</servlet-class>
    <init-param>
      <param-name>contextConfigLocation</param-name>
      <param-value>classpath*:conf-spring/spring-mvc.xml</param-value>
    </init-param>
    <load-on-startup>1</load-on-startup>
  </servlet>
  <listener>
    <listener-class>com.cmwa.ecc.business.listener.ClientSessionListener</listener-class>
  </listener>
   <filter>
    <filter-name>encodingFilter</filter-name>
    <filter-class>org.springframework.web.filter.CharacterEncodingFilter</filter-class>
    <init-param>
      <param-name>encoding</param-name>
      <param-value>UTF-8</param-value>
    </init-param>
    <init-param>
      <param-name>forceEncoding</param-name>
      <param-value>true</param-value>
    </init-param>
  </filter>
  <filter-mapping>
    <filter-name>encodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter>
    <filter-name>AjaxPostEncodingFilter</filter-name>
    <filter-class>com.cmwa.ecc.business.filter.AjaxPostEncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>XssEscape</filter-name>
    <filter-class>com.cmwa.ecc.business.filter.CheckFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>XssEscape</filter-name>
    <url-pattern>/*</url-pattern>
    <dispatcher>REQUEST</dispatcher>
  </filter-mapping>
  <!-- 记录用户访问 的地址 start -->
  <filter>
    <filter-name>registerCallURLFilter</filter-name>
    <filter-class>com.cmwa.ecc.business.filter.RegisterCallURLFilter</filter-class>
    <init-param>  
        <param-name>excludeURL</param-name>  
        <param-value>service/index/indexTransfer.do</param-value>
    </init-param>  
  </filter>
  <filter-mapping>
    <filter-name>registerCallURLFilter</filter-name>
    <url-pattern>*.xhtml</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>registerCallURLFilter</filter-name>
    <url-pattern>*.do</url-pattern>
  </filter-mapping>
  <!-- 记录用户访问 的地址 end -->
  <!-- 单点登录  start	-->
  <!--CAS: 用于单点退出     -->
    <listener>  
        <listener-class>org.jasig.cas.client.session.SingleSignOutHttpSessionListener</listener-class>  
    </listener> 
    
    <!-- 该过滤器用于实现单点登出功能。--> 
    <filter>  
        <filter-name>CAS Single Sign Out Filter</filter-name>  
        <filter-class>org.jasig.cas.client.session.SingleSignOutFilter</filter-class>  
    </filter>  
    <filter-mapping>  
        <filter-name>CAS Single Sign Out Filter</filter-name>  
        <url-pattern>*.do</url-pattern>
    </filter-mapping>
    <filter-mapping>  
        <filter-name>CAS Single Sign Out Filter</filter-name>  
        <url-pattern>*.xhtml</url-pattern>
    </filter-mapping>
    <!--该过滤器负责对Ticket的校验工作，必须启用它-->
    <filter>  
        <filter-name>CAS Validation Filter</filter-name>  
        <filter-class>org.jasig.cas.client.validation.Cas20ProxyReceivingTicketValidationFilter</filter-class>  
        <init-param>  
            <param-name>casServerUrlPrefix</param-name>  
            <!--下面的URL是Cas服务器的认证地址    -->
            <!-- 此处必须使用IP地址加端口号 -->
            <param-value>http://192.168.6.232:8080</param-value>
        </init-param>  
        <init-param>  
            <param-name>service</param-name>  
            <!--下面的URL是项目的访问地址    -->
            <param-value>http://business.cmwachina.com/service/index/indexTransfer.do</param-value>   
        </init-param>  
        <init-param>
            <param-name>redirectAfterValidation</param-name>
            <param-value>false</param-value>
        </init-param> 
    </filter>  
    <filter-mapping>  
        <filter-name>CAS Validation Filter</filter-name>  
        <url-pattern>*.do</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>CAS Validation Filter</filter-name>  
        <url-pattern>*.xhtml</url-pattern>  
    </filter-mapping>
    
  <!--该过滤器负责用户的认证工作，必须启用它-->  
    <!-- 若有接口需要对外暴露，且在服务器上进行调用，则需要重写此过滤器并设置相应的接口不做拦截	 -->
    <filter>  
        <filter-name>CASFilter</filter-name>  
        <filter-class>org.jasig.cas.client.authentication.AuthenticationFilter</filter-class>  
        <init-param>  
            <param-name>casServerLoginUrl</param-name>  
            <!--下面的URL是Cas服务器的登录地址     -->
            <!-- 此处必须使用域名 -->
            <!-- http://cas.cmfchina.com  -->
            <param-value>http://cas.cmfchina.com</param-value>
        </init-param>  
        <init-param>  
            <param-name>service</param-name>  
            <!--下面的URL是项目的访问地址  -->
            <param-value>http://business.cmwachina.com/service/index/indexTransfer.do</param-value>   
        </init-param>  
    </filter>  
    <filter-mapping>  
        <filter-name>CASFilter</filter-name>  
        <url-pattern>*.do</url-pattern>  
    </filter-mapping>
    <filter-mapping>  
        <filter-name>CASFilter</filter-name>  
        <url-pattern>*.xhtml</url-pattern>  
    </filter-mapping>
    
     <!--该过滤器来获取用户的登录名。 比如AssertionHolder.getAssertion().getPrincipal().getName()。  -->
     <!--此过滤器用来获取单点登录的用户名，以便后续获取用户信息处理相关事务-->
    <filter>  
        <filter-name>CAS Assertion Thread Local Filter</filter-name>  
        <filter-class>org.jasig.cas.client.util.AssertionThreadLocalFilter</filter-class>  
    </filter>  
    <filter-mapping>  
        <filter-name>CAS Assertion Thread Local Filter</filter-name>  
        <url-pattern>*.do</url-pattern>  
    </filter-mapping>
    <filter-mapping>  
        <filter-name>CAS Assertion Thread Local Filter</filter-name>  
        <url-pattern>*.xhtml</url-pattern>  
    </filter-mapping>
    <!--根据单点登录的结果设置本系统的用户信息-->
    <!-- 在自己的过滤器中使用AssertionHolder.getAssertion().getPrincipal().getName()获取用户名 -->
    <filter>  
        <filter-name>SSOLoginFilter</filter-name>  
        <filter-class>com.cmwa.ecc.business.filter.SSOLoginFilter</filter-class> 
    </filter>  
    <filter-mapping>  
        <filter-name>SSOLoginFilter</filter-name>  
        <url-pattern>*.do</url-pattern>  
    </filter-mapping>   
    <filter-mapping>  
        <filter-name>SSOLoginFilter</filter-name>  
        <url-pattern>*.xhtml</url-pattern>  
    </filter-mapping>
  <!-- 单点登录  end 	-->
  <!-- 拦截验证登录	start -->
  <filter>
    <filter-name>CookieSSOFilter</filter-name>
    <filter-class>com.cmwa.ecc.business.filter.CookieSSOFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>AjaxPostEncodingFilter</filter-name>
    <url-pattern>*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>CookieSSOFilter</filter-name>
    <url-pattern>*.do</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>CookieSSOFilter</filter-name>
    <url-pattern>*.xhtml</url-pattern>
  </filter-mapping>
  <!-- 拦截验证登录	end -->
  <filter>
    <filter-name>GlobalFilter</filter-name>
    <filter-class>com.cmwa.ecc.business.filter.GlobalFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>GlobalFilter</filter-name>
    <url-pattern>*.do</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>GlobalFilter</filter-name>
    <url-pattern>*.jsp</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>GlobalFilter</filter-name>
    <url-pattern>*.xhtml</url-pattern>
  </filter-mapping>
  
  <!-- filter AjaxSendRedirectFilter start  -->
	<filter>
		<filter-name>ajaxSendRedirectFilter</filter-name>
		<filter-class>com.cmwa.ecc.business.filter.AjaxSendRedirectFilter</filter-class>
	</filter>
	<filter-mapping>
		<filter-name>ajaxSendRedirectFilter</filter-name>
		<url-pattern>*.action</url-pattern>
	</filter-mapping>
	<!-- <filter-mapping>
		<filter-name>ajaxSendRedirectFilter</filter-name>
		<url-pattern>*.html</url-pattern>
	</filter-mapping>
	filter AjaxSendRedirectFilter end  -->
	
  <jsp-config>
    <taglib>
      <taglib-uri>/wasp-tags</taglib-uri>
      <taglib-location>/WEB-INF/tld/tagWaspLib.tld</taglib-location>
    </taglib>
  </jsp-config>
  <servlet-mapping>
    <servlet-name>springServlet</servlet-name>
    <url-pattern>*.xhtml</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>springServlet</servlet-name>
    <url-pattern>*.do</url-pattern>
  </servlet-mapping>
  <servlet-mapping>
    <servlet-name>springServlet</servlet-name>
    <url-pattern>*.action</url-pattern>
  </servlet-mapping>
  <welcome-file-list>
    <welcome-file>service/index.jsp</welcome-file>
  </welcome-file-list>
</web-app>